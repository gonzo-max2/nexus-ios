# Copy to .env and adjust. The server reads process.env directly.
PORT=8787
# If set, clients must send: Authorization: Bearer <this value>
INGEST_TOKEN=
# Where audio segments are stored on disk.
DATA_DIR=./data
# Automatically group original audio segments into downloadable time windows.
AUDIO_BATCH_MINUTES=5
# Per-device retention. The first reached limit applies; downloads are snapshots.
RETENTION_MAX_SEGMENTS=2000
RETENTION_MAX_AGE_MS=86400000
RETENTION_MAX_BYTES=2147483648
